  "type": "commonjs",
  "scripts": {
    "api": "pnpm --filter api run",
    "ui": "pnpm --filter ui run",
    "api:dev": "bash scripts/api-dev.sh",
    "api:clean": "docker ps -aq --filter ancestor=public.ecr.aws/lambda/nodejs:20-rapid-x86_64 | xargs -r docker rm -f && rm -rf .aws-sam",
    "deploy:ui": "bash scripts/deploy-ui.sh",
    "deploy": "sam deploy && node scripts/postdeploy-config.mjs",
    "update-api-url": "node scripts/postdeploy-config.mjs"
  },
